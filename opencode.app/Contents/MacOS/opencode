#!/usr/bin/osascript

on run
    set opencodeCommand to "opencode"
    if not my ptyIsAvailable("/usr/bin/python3") then
        display dialog "macOS cannot allocate a terminal. Restart OpenChamber to release leaked pseudo-terminals, then try again." buttons {"OK"} default button "OK" with icon stop
        return
    end if

    set iTermWasRunning to application "iTerm" is running

    tell application "iTerm"
        if iTermWasRunning and (count of windows) > 0 then
            activate

            tell current window
                tell current session
                    split vertically with default profile command opencodeCommand
                end tell
            end tell
        else
            activate
            create window with default profile command opencodeCommand
        end if

        my bringItermToFront()
    end tell
end run

on ptyIsAvailable(pythonExecutable)
    set probeCode to "import os; master, slave = os.openpty(); os.close(master); os.close(slave)"

    try
        do shell script quoted form of pythonExecutable & " -c " & quoted form of probeCode
        return true
    on error
        return false
    end try
end ptyIsAvailable

on bringItermToFront()
    tell application "iTerm"
        activate
    end tell

    delay 0.1

    try
        tell application "System Events"
            tell process "iTerm2"
                set frontmost to true
            end tell
        end tell
    end try
end bringItermToFront
